# All optional. Unset secrets are generated on first boot, saved to /data,
# and printed in the logs.
PANEL_PATH=/change-me-panel/
SUB_PATH=/change-me-sub/
WS_SECRET=change-me-ws
ADMIN_USER=admin
ADMIN_PASSWORD=
# Public hostname clients use (shown in the panel and subscription links).
PUBLIC_HOST=

# Komari agent (runs only when both are set). Auto-update is always off;
# web SSH is on; set AGENT_DISABLE_WEB_SSH=true to turn it off.
AGENT_DISABLE_WEB_SSH=false
AGENT_ENDPOINT=
AGENT_TOKEN=
AGENT_INTERVAL=3
AGENT_IGNORE_UNSAFE_CERT=false

# Decoy: a random site is generated on first boot and kept in /data/decoy-gen.
# Set false to serve the bundled page instead. A site in /data/decoy always wins.
DECOY_RANDOM=true
